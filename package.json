{
  "name": "preptrack",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PREPTRACK \u2014 personal UPSC CSE 2027 preparation tracker (Geography Optional)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node scripts/syllabus-consistency-test.mjs && vite build --mode localtest && node scripts/logic-test.mjs && node scripts/flipclock-test.mjs && node scripts/wipe-test.mjs && node scripts/smoke-test.mjs",
    "test:syllabus": "node scripts/syllabus-consistency-test.mjs",
    "test:logic": "node scripts/logic-test.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "generate:syllabus": "node scripts/extract-reference-syllabus.mjs",
    "test:wipe": "node scripts/wipe-test.mjs",
    "test:flipclock": "node scripts/flipclock-test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "jsdom": "^24.1.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "ws": "^8.21.3"
  }
}
